  shorttitle = {Convolutional {{L2LFlows}}},
  author = {Buss, Thorsten and Gaede, Frank and Kasieczka, Gregor and Krause, Claudius and Shih, David},
  year = {2024},
  month = sep,
  journal = {Journal of Instrumentation},
  volume = {19},
